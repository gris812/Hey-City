PORT=4000
NODE_ENV=development
GOOGLE_MAPS_API_KEY=
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-4o-mini
OPENAI_TTS_MODEL=gpt-4o-mini-tts
AI_PRIMARY_PROVIDER=openai
# Auxiliary AI stays disabled until a small-model benchmark is accepted.
AI_AUXILIARY_PROVIDER=deterministic
NARRATIVE_PROMPT_VERSION=v1

# Ahead Discovery provider refresh can be lowered to 15 minutes for field testing.
AHEAD_DISCOVERY_PROVIDER_REFRESH_MINUTES=60
AHEAD_DISCOVERY_EVALUATION_SECONDS=20
AHEAD_DISCOVERY_MAX_HEADING_DELTA_DEGREES=70
AHEAD_DISCOVERY_TARGET_DISTANCE_MIN_M=500
AHEAD_DISCOVERY_TARGET_DISTANCE_MAX_M=25000
AHEAD_DISCOVERY_PROVIDER_TIMEOUT_MS=4500
# Shared across sessions for the same projected geo cell.
AHEAD_DISCOVERY_PROVIDER_CACHE_TTL_SECONDS=900
