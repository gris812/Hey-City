PORT=4000
NODE_ENV=development
GOOGLE_MAPS_API_KEY=
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-5.6-luna
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TEXT_INPUT_USD_PER_MILLION=0.20
OPENAI_TEXT_OUTPUT_USD_PER_MILLION=1.20
# M4 remains deterministic in development. Select openai or gemini only after
# the identical B1-B6 live benchmark has been accepted.
REALTIME_VOICE_PROVIDER=deterministic
OPENAI_REALTIME_MODEL=gpt-realtime
GEMINI_LIVE_MODEL=gemini-live-2.5-flash-preview
GEMINI_API_KEY=
REALTIME_INACTIVITY_TIMEOUT_MS=45000
REALTIME_MAX_SESSION_DURATION_MS=600000
REALTIME_MAX_CONCURRENT_SESSIONS=20
# Set current provider prices before a live cost benchmark.
OPENAI_REALTIME_INPUT_AUDIO_USD_PER_MILLION=0
OPENAI_REALTIME_OUTPUT_AUDIO_USD_PER_MILLION=0
GEMINI_LIVE_INPUT_AUDIO_USD_PER_MILLION=0
GEMINI_LIVE_OUTPUT_AUDIO_USD_PER_MILLION=0
AI_PRIMARY_PROVIDER=openai
# Auxiliary AI stays disabled until a small-model benchmark is accepted.
AI_AUXILIARY_PROVIDER=deterministic
NARRATIVE_PROMPT_VERSION=v1

# Ahead Discovery provider refresh can be lowered to 15 minutes for field testing.
AHEAD_DISCOVERY_PROVIDER_REFRESH_MINUTES=60
AHEAD_DISCOVERY_EVALUATION_SECONDS=20
AHEAD_DISCOVERY_MAX_HEADING_DELTA_DEGREES=70
AHEAD_DISCOVERY_TARGET_DISTANCE_MIN_M=500
AHEAD_DISCOVERY_TARGET_DISTANCE_MAX_M=25000
AHEAD_DISCOVERY_PROVIDER_TIMEOUT_MS=4500
# Shared across sessions for the same projected geo cell.
AHEAD_DISCOVERY_PROVIDER_CACHE_TTL_SECONDS=900
