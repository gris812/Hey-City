# Copy to .env and fill in. .env is gitignored.

# Google Maps SDK keys (Maps only)
EXPO_PUBLIC_GOOGLE_MAPS_IOS_KEY=
EXPO_PUBLIC_GOOGLE_MAPS_ANDROID_KEY=

# Backend API URL.
# Simulator may use localhost. A physical iPhone MUST use a reachable Mac LAN/staging URL.
# PR #17 M4 benchmark requires a backend whose /health advertises m4_realtime_voice.
EXPO_PUBLIC_API_URL=http://localhost:4000

# M4 field benchmark (development builds only; never put provider keys here)
EXPO_PUBLIC_M4_NATIVE_BENCHMARK_ENABLED=false
EXPO_PUBLIC_GIT_SHA=local
