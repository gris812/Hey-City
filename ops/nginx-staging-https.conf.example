# Second phase: use only AFTER the new staging certificate exists.
# Keep this site independent of existing Hey City and Hackshelf sites.
server {
    listen 80;
    server_name staging-api.heycity.stolbergco.com;
    location /.well-known/acme-challenge/ {
        root /var/www/letsencrypt;
    }
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    server_name staging-api.heycity.stolbergco.com;

    ssl_certificate /etc/letsencrypt/live/staging-api.heycity.stolbergco.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/staging-api.heycity.stolbergco.com/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    client_max_body_size 26m;
    location / {
        proxy_pass http://127.0.0.1:4110;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 120s;
    }
}
