#!/usr/bin/env bash
# Dedicated staging SSH forced command. Deny interactive shell and all other commands.
set -euo pipefail
if [[ "${SSH_ORIGINAL_COMMAND:-}" =~ ^(deploy|diagnose)\ ([a-f0-9]{40})$ ]]; then
  exec sudo -n /usr/local/sbin/heycity-staging-deploy "${BASH_REMATCH[2]}" "${BASH_REMATCH[1]}"
fi
if [[ "${SSH_ORIGINAL_COMMAND:-}" =~ ^inspect\ ([a-f0-9]{40})\ (sha256:[a-f0-9]{64})$ ]]; then
  exec sudo -n /usr/local/sbin/heycity-staging-deploy "${BASH_REMATCH[1]}" inspect "${BASH_REMATCH[2]}"
fi
echo 'Unauthorized staging operation' >&2
exit 64
