#!/usr/bin/env bash
# Root-owned staging-only image receiver. Must NEVER be editable by the SSH account.
set -euo pipefail
umask 077
if [[ "$(id -u)" != 0 || $# != 1 || ! "$1" =~ ^[a-f0-9]{40}$ ]]; then
  echo 'Invalid staging deployment invocation' >&2
  exit 64
fi
sha="$1"
image="heycity-staging-api:git-$sha"
base=/opt/HeyCity-staging
compose="$base/docker-compose.staging.yml"
envfile="$base/.env.staging"
if [[ ! -f "$compose" || ! -f "$envfile" || ! -O "$compose" || ! -O "$envfile" ]]; then
  echo 'Root-owned staging configuration required' >&2; exit 78
fi
if [[ $(stat -c '%a' "$envfile") != 600 ]]; then
  echo 'Staging credentials permissions must be 600' >&2; exit 78
fi
if id -nG heycity-staging-ci | tr ' ' '\n' | grep -qx docker; then
  echo 'Staging identity must not belong to docker group' >&2; exit 78
fi

curl -fsS --max-time 8 http://127.0.0.1:4100/health >/dev/null || {
  echo 'Production API health precheck failed' >&2; exit 75;
}
running=$(docker ps --filter 'label=com.docker.compose.project=heycity-staging' --format '{{.ID}}' | wc -l)
available=$(free -m | awk '/^Mem:/ {print $7}')
if [[ -z "$available" || "$available" -lt 250 || ( "$running" -eq 0 && "$available" -lt 600 ) ]]; then
  echo 'Host memory gate failed; staging not started' >&2; exit 75
fi

archive=$(mktemp /tmp/heycity-staging-image.XXXXXXXX.tar)
trap 'rm -f "$archive"' EXIT
if ! timeout 240 head -c 1073741825 > "$archive"; then
  echo 'Image transfer failed' >&2; exit 75
fi
if [[ ! -s "$archive" || $(stat -c '%s' "$archive") -gt 1073741824 ]]; then
  echo 'Image archive exceeds 1GiB or is empty' >&2; exit 75
fi
python3 - "$archive" "$image" <<'PY'
import json, sys, tarfile
path, expected = sys.argv[1:]
try:
    with tarfile.open(path, 'r:') as tar:
        f = tar.extractfile('manifest.json')
        entries = json.load(f) if f else []
    if len(entries) != 1 or entries[0].get('RepoTags') != [expected]:
        raise ValueError('unexpected image tag')
except Exception:
    print('Image manifest validation failed', file=sys.stderr)
    sys.exit(78)
PY

docker load -i "$archive" >/dev/null
revision=$(docker image inspect --format '{{index .Config.Labels "org.opencontainers.image.revision"}}' "$image")
arch=$(docker image inspect --format '{{.Architecture}}' "$image")
os=$(docker image inspect --format '{{.Os}}' "$image")
if [[ "$revision" != "$sha" || "$arch" != amd64 || "$os" != linux ]]; then
  echo 'Image revision or platform mismatch' >&2; exit 78
fi

# Only root-owned staging files. The environment overrides the image selector.
export STAGING_API_IMAGE="$image"
compose_cmd=(docker compose --project-name heycity-staging --env-file "$envfile" -f "$compose")
"${compose_cmd[@]}" config --quiet
"${compose_cmd[@]}" up -d --no-build --pull never >/dev/null
ok=0
for try in $(seq 1 24); do
  if curl -fsS --max-time 5 http://127.0.0.1:4110/health >/dev/null 2>&1; then ok=1; break; fi
  sleep 5
done
if [[ "$ok" != 1 ]]; then
  echo 'Staging health failed; stopping staging only' >&2
  "${compose_cmd[@]}" stop >/dev/null || true
  exit 75
fi
if ! curl -fsS --max-time 8 http://127.0.0.1:4100/health >/dev/null; then
  echo 'Production API health changed; stopping staging only' >&2
  "${compose_cmd[@]}" stop >/dev/null || true
  exit 75
fi
printf 'staging_sha=%s\n' "$sha"
printf 'staging_image_id=%s\n' "$(docker image inspect --format '{{.Id}}' "$image")"
echo 'staging_health=ok production_health=ok'
