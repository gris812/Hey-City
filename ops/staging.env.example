# Template only; put actual values in an untracked .env.staging (chmod 600).
# Never copy production DB/password/JWT/OTP secrets to staging.
# Temporary provider-key reuse: only Google Maps, OpenAI and Resend values when explicitly
# operator-authorized as in ops/STAGING_DEPLOYMENT.md; never copy production .env wholesale.
STAGING_API_IMAGE=heycity-staging-api:git-REPLACE_WITH_REVIEWED_SHA
STAGING_POSTGRES_PASSWORD=REPLACE_WITH_OPENSSL_RAND_HEX_32

NODE_ENV=staging
PORT=4000
PUBLIC_API_URL=https://staging-api.heycity.stolbergco.com
CORS_ORIGINS=https://staging.heycity.stolbergco.com
DATABASE_SSL=false
MEDIA_DIRECTORY=/app/data/media
AUTH_DISABLED=false

JWT_SECRET=REPLACE_WITH_DISTINCT_RANDOM_48_BYTE_HEX
OTP_PEPPER=REPLACE_WITH_DISTINCT_RANDOM_48_BYTE_HEX
ADMIN_EMAIL=REPLACE_WITH_TEST_ADMIN_EMAIL
ADMIN_AUTH_CODE=REPLACE_WITH_DISTINCT_PRIVATE_CODE
TESTER_EMAIL_ALLOWLIST=REPLACE_WITH_TESTER_EMAILS_ONLY
RESEND_API_KEY=REPLACE_WITH_SCOPED_RESEND_KEY
AUTH_FROM_EMAIL=Hey City <login@heycity.stolbergco.com>

GOOGLE_MAPS_API_KEY=REPLACE_WITH_STAGING_RESTRICTED_KEY
OPENAI_API_KEY=REPLACE_WITH_STAGING_RESTRICTED_KEY
# Gemini key only if selected during later authorized benchmark.
GEMINI_API_KEY=
AI_PRIMARY_PROVIDER=openai
AI_AUXILIARY_PROVIDER=deterministic
REALTIME_VOICE_PROVIDER=deterministic
M4_NATIVE_BENCHMARK_PROVIDER_OVERRIDE_ENABLED=false

MAX_GOOGLE_CALLS_PER_MINUTE_PER_USER=2
MAX_PLACES_CALLS_PER_MINUTE_PER_USER=1
MAX_MATRIX_CALLS_PER_MINUTE_PER_USER=1
REALTIME_MAX_CONCURRENT_SESSIONS=2
USAGE_RETENTION_DAYS=7
