NODE_ENV=production
PORT=4000
PUBLIC_API_URL=https://api.heycity.stolbergco.com
CORS_ORIGINS=https://heycity.stolbergco.com
DATABASE_SSL=false
POSTGRES_PASSWORD=generate-a-long-random-password
JWT_SECRET=generate-at-least-32-random-characters
OTP_PEPPER=generate-at-least-32-random-characters
RESEND_API_KEY=set-on-server-only
AUTH_FROM_EMAIL="Hey City <login@heycity.stolbergco.com>"
ADMIN_EMAIL=admin@example.com
ADMIN_AUTH_CODE=set-on-server-only
TESTER_EMAIL_ALLOWLIST=admin@example.com,tester@example.com
USAGE_RETENTION_DAYS=30
GOOGLE_MAPS_API_KEY=set-server-restricted-key
GOOGLE_MAPS_BROWSER_KEY=set-http-referrer-restricted-key
AHEAD_DISCOVERY_PROVIDER_CACHE_TTL_SECONDS=900
# Keep discovery on Nearby Search Pro; rating/userRatingCount would promote it to Enterprise.
GOOGLE_PLACES_NEW_FIELD_MASK=places.id,places.displayName,places.location,places.types
OPENAI_API_KEY=set-on-server-only
OPENAI_TEXT_MODEL=gpt-4o-mini
OPENAI_TTS_MODEL=gpt-4o-mini-tts
AI_PRIMARY_PROVIDER=openai
AI_AUXILIARY_PROVIDER=deterministic
NARRATIVE_PROMPT_VERSION=v1
OPENAI_TEXT_INPUT_USD_PER_MILLION=0.10
OPENAI_TEXT_OUTPUT_USD_PER_MILLION=0.60
OPENAI_TTS_INPUT_USD_PER_MILLION=0.60
OPENAI_TTS_OUTPUT_USD_PER_MILLION=12.00
GOOGLE_PLACES_USD_PER_THOUSAND=32.00
GOOGLE_GEOCODING_USD_PER_THOUSAND=5.00
GOOGLE_MATRIX_ELEMENT_USD_PER_THOUSAND=5.00
GOOGLE_DYNAMIC_MAP_USD_PER_THOUSAND=7.00
MEDIA_DIRECTORY=/app/data/media
